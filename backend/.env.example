# 复制为 backend/.env 后填写。backend/.env 已被 gitignore，不要提交真实 key。
# AI_MODEL 填模型名称；AI_API_KEY 填 API key。
AI_MODEL=
AI_API_KEY=

# openai（默认）、其他服务名（如 deepseek）或 local（强制使用本地确定性草稿）。
# 使用其他服务时，把 AI_BASE_URL 指向该服务的 API 根地址。
AI_PROVIDER=openai

# API 根地址，不要包含 /responses、/chat/completions 或 /v1/messages。
# 默认 https://api.openai.com/v1
# AI_BASE_URL=https://api.openai.com/v1

# responses = OpenAI Responses API（AI_PROVIDER=openai 时的默认值）
# chat      = OpenAI 兼容的 Chat Completions API（其他 provider 的默认值）
# anthropic = Anthropic Messages API；DeepSeek 的 Anthropic 兼容地址示例：
#   AI_PROVIDER=deepseek
#   AI_BASE_URL=https://api.deepseek.com/anthropic
#   AI_API_STYLE=anthropic
# AI_API_STYLE=responses

# 兼容旧配置名：AI_API_KEY 未设置时会读取 OPENAI_API_KEY。
# OPENAI_API_KEY=

# 仅测试环境设为 1；生产环境不要设置。
# DEALER_AI_TEST_MODE=1
